# Backend only. Copy to .env and populate locally; never commit real keys.
FUYAO_API_KEY=

# Optional AI: both key and model are required. Leave blank for factual fallback.
# Use an HTTPS OpenAI-compatible endpoint that supports strict json_schema output.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Optional follow-up ranking: at most one extra model call after successful interpretation.
LLM_FOLLOW_UP_ENABLED=false
